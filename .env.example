# Copy to .env on the server (deploy/deploy.sh does this for you on first run).

# Public address of the site (used for sitemap, social previews). No trailing slash.
SITE_URL=https://example.com

# First-run admin login. After the first successful sign-in the account is stored
# (hashed) in data/admin.json and these two values are no longer used — change the
# password from the admin panel afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional: fixed secret for admin sessions (otherwise one is generated in data/session.key).
# SESSION_SECRET=

# Optional: host port / bind address for docker compose.
# NIRA_PORT=3500
# NIRA_BIND=127.0.0.1
